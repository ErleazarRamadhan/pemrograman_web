@base = http://localhost:3000/produk

### 1 GET semua
GET {{base}}

### 2 GET satu
GET {{base}}/1

### 3 POST valid
POST {{base}}
Content-Type: application/json

{
  "nama": "Americano",
  "kategori": "Kopi",
  "harga": 26000,
  "deskripsi": "Espresso dengan air panas, rasa bersih dan kuat."
}

### 4 PATCH
PATCH {{base}}/7
Content-Type: application/json

{ "harga": 27000 }

### 5 DELETE
DELETE {{base}}/7

### 6 ERROR 400 validasi gagal
POST {{base}}
Content-Type: application/json

{ "nama": "Ab", "kategori": "Teh", "harga": 100, "deskripsi": "x" }

### 7 ERROR 404 id tidak ada
GET {{base}}/999

### 8 ERROR 409 nama duplikat
POST {{base}}
Content-Type: application/json

{ "nama": "Tiramisu", "kategori": "Pastry", "harga": 32000, "deskripsi": "Duplikat" }